# Dipakai docker-compose.yml (root). Config aplikasi ada di backend/.env
# (salin dari backend/.env.example — jangan isi DATABASE_URL, compose yang set).
POSTGRES_PASSWORD=ganti-dengan-password-panjang-acak
ADMIN_DEFAULT_USERNAME=admin
# Min 12 karakter, lolos password policy. WAJIB (migration gagal kalau kosong di production).
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_FULLNAME=Administrator
HTTP_PORT=8080
# Isi 127.0.0.1 kalau ada Caddy/nginx di host yang jadi pintu masuk HTTPS (port 8080 jadi tidak terbuka ke luar).
HTTP_BIND=0.0.0.0
# 1 = cuma nginx frontend di depan API. 2 = ada Caddy/LB TLS di depan nginx.
TRUST_PROXY_HOPS=1
