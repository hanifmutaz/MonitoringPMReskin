# Server
NODE_ENV=development
PORT=4000

# Database aplikasi (PM Monitoring)
DATABASE_URL=postgresql://pm_app_user:xxxxx@localhost:5432/pm_monitoring

# Database ConMas (READ-ONLY) — WAJIB akun terpisah dengan grant SELECT
# saja ke view_report_25415, BUKAN akun yang dipakai sistem ConMas untuk
# operasi CRUD-nya sendiri. Kalau dikosongkan, sync job otomatis di-skip
# (server tetap jalan normal, cuma production_cache gak ke-update).
CONMAS_DB_HOST=xxx
CONMAS_DB_PORT=5432
CONMAS_DB_NAME=xxx
CONMAS_DB_USER=pm_readonly_sync
CONMAS_DB_PASSWORD=xxxxx

# Auth
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production: WAJIB >= 32 karakter & bukan placeholder, kalau tidak app menolak start.
JWT_SECRET=xxxxx
JWT_EXPIRES_IN=8h
# Sesi lebih panjang khusus role 'Display' (akun monitor/TV)
JWT_EXPIRES_IN_DISPLAY=30d

# Reverse proxy & cookie
# TRUST_PROXY_HOPS = jumlah proxy di depan app (nginx=1; nginx + LB/Caddy di depannya=2; tanpa proxy=0)
TRUST_PROXY_HOPS=1
# Default Secure=true di production (wajib HTTPS). Set false HANYA untuk LAN tanpa HTTPS.
# COOKIE_SECURE=true

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP (opsional) — kalau dikosongkan, notifikasi email otomatis di-skip
# (job tetap jalan, cuma gak kirim email). Aman dikosongkan pas dev lokal
# biar gak nyasar kirim email beneran pas testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PM Monitoring <no-reply@hirose.local>

# Logging
LOG_LEVEL=info

# Multi-site reporting — identitas lokasi instance ini sendiri.
# 'internal' di server Internal, 'sgp' di server Subcont SGP, 'systech' di
# server Subcont Systech. Default 'internal' kalau dikosongkan.
SITE_ID=internal

# Paket lisensi yang dibeli client instance ini — 'A' (PM Monitoring
# standalone) atau 'B' (PM Monitoring + Inventory Integration). Kalau
# dikosongkan atau nilainya bukan A/B, otomatis fallback ke 'B' (full akses,
# fail open — lihat catatan di config/env.js). WAJIB diisi 'A' secara
# eksplisit di instance client yang cuma beli Paket A.
LICENSE_PACKAGE=B

# API key milik instance INI SENDIRI — dipakai buat memverifikasi request
# masuk ke GET /api/v1/reporting/site-summary (dipanggil server lain, BUKAN
# via login). Kalau dikosongkan, endpoint itu otomatis nolak SEMUA request
# (fail closed) — aman dikosongkan pas dev kalau gak lagi test fitur ini.
# Generate: openssl rand -hex 32
REPORTING_API_KEY=

# CUMA diisi di instance Internal — dipakai multiSiteService buat narik data
# dari tiap Subcont. BASE_URL = alamat server Subcont, API_KEY = REPORTING_API_KEY
# milik Subcont itu (dikasih tau manual oleh mereka, BUKAN dari kode). Kosongkan
# semua REMOTE_SITE_* di instance Subcont (SGP/Systech) — mereka gak perlu ini.
# REMOTE_SITE_1_ID=sgp
# REMOTE_SITE_1_LABEL=Subcont SGP
# REMOTE_SITE_1_BASE_URL=https://sgp.pm-monitoring.internal
# REMOTE_SITE_1_API_KEY=

# REMOTE_SITE_2_ID=systech
# REMOTE_SITE_2_LABEL=Subcont Systech
# REMOTE_SITE_2_BASE_URL=https://systech.pm-monitoring.internal
# REMOTE_SITE_2_API_KEY=

# Timeout (ms) per-site saat Internal narik data Subcont — biar 1 Subcont
# yang lemot/down gak nge-hang seluruh request /dashboard/multi-site.
# REMOTE_SITE_FETCH_TIMEOUT_MS=5000

# Seed Admin pertama (dipakai oleh migration seed-admin-user, HAPUS/ganti setelah migration jalan sekali).
# Production: ADMIN_DEFAULT_PASSWORD WAJIB diisi (min 12 karakter, lolos password policy);
# migration akan gagal kalau kosong. Di dev/test fallback ke 'ChangeMe123!'.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=xxxxx
ADMIN_DEFAULT_FULLNAME=Administrator

# --- Tuning DB pool (semua opsional) ---
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONN_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=          # kosong = tanpa timeout (job recompute/import bisa lama)
# DB_SSL=true                       # DB remote/managed yang mewajibkan TLS
# DB_SSL_REJECT_UNAUTHORIZED=true   # false HANYA untuk sertifikat self-signed

# --- Graceful shutdown ---
# SHUTDOWN_TIMEOUT_MS=20000

# Backup database lewat tombol "Backup Sekarang" di Settings > Umum (Admin).
# Memakai `pg_dump`. Di Docker sudah terpasang di image (tidak perlu diisi).
# Di deployment non-Docker (mis. Windows/IIS) isi path lengkap pg_dump, versi
# HARUS sama atau lebih baru dari server Postgres, contoh:
#   PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# PG_DUMP_PATH=
# Batas waktu satu backup (ms), default 600000 (10 menit).
# BACKUP_TIMEOUT_MS=600000
