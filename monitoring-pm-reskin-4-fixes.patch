+    const values = roleIds.map((_, i) => `($1, $${i + 2})`).join(', ');
+    await client.query(
+      `INSERT INTO setting_role_access (setting_key, role_id) VALUES ${values}`,
+      [key, ...roleIds]
+    );
+  }
+}
+
+module.exports = {
