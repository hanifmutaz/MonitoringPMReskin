From 48223242ad696e89b11b73e3b00f6885ec2471b4 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.local>
Date: Mon, 10 Aug 2026 06:08:49 +0000
Subject: [PATCH] Fix: icon collapsed belum rata tengah + toggle icon masih
 jauh dari sidebar

- Sidebar.jsx: gap flex di tombol NavGroup sekarang kondisional (gap-0 pas collapsed, gap-3 pas expanded). Sebelumnya gap-3 tetap kepasang walau label/chevron udah disusutin ke lebar 0, jadi justify-center ngerata-tengahin "icon + ruang kosong dari gap" bukan icon doang - makanya icon keliatan nempel kiri, bukan center beneran.

- Topbar.jsx: padding-left header sekarang kondisional (16px pas collapsed, 32px pas expanded, di-override lewat inline style + transition 250ms) - biar tombol toggle lebih deket ke sidebar pas collapsed, gak selalu 32px flat kayak sebelumnya.

Verified: npx vite build sukses, npx eslint bersih, class gap-0/justify-start baru ke-generate di dist CSS.
---
 frontend/src/components/Sidebar.jsx | 11 +++++++++--
 frontend/src/components/Topbar.jsx  | 16 +++++++++++++++-
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/frontend/src/components/Sidebar.jsx b/frontend/src/components/Sidebar.jsx
index 56dae24..f1876f5 100644
--- a/frontend/src/components/Sidebar.jsx
+++ b/frontend/src/components/Sidebar.jsx
@@ -158,8 +158,15 @@ function NavGroup({ group, isOpen, onToggle, isGroupActive, summary, collapsed }
       onClick={onToggle}
       aria-expanded={expandedOpen}
       aria-label={group.label}
-      className={`flex w-full cursor-pointer items-center gap-3 rounded-lg border-0 bg-transparent text-sm no-underline transition-[background-color,color,padding] duration-[250ms] ease-in-out ${
-        collapsed ? 'justify-center p-2.5' : 'px-3 py-2.5'
+      className={`flex w-full cursor-pointer items-center rounded-lg border-0 bg-transparent text-sm no-underline transition-[background-color,color,padding,gap] duration-[250ms] ease-in-out ${
+        // FIX: pas collapsed, gap HARUS 0 - label & chevron di bawah cuma
+        // disusutin lebarnya jadi 0 (max-w-0), bukan di-unmount, tapi kalau
+        // gap-3 tetap kepasang, flexbox masih ngasih jarak 12px ke tiap sisi
+        // elemen ber-lebar-0 itu. Efeknya `justify-center` ngerata-tengahin
+        // "icon + ruang kosong dari gap" (bukan icon doang), jadi icon
+        // keliatan nempel ke kiri, gak bener-bener center. Icon-only jadi
+        // gak butuh gap sama sekali karena cuma 1 elemen yang keliatan.
+        collapsed ? 'justify-center gap-0 p-2.5' : 'justify-start gap-3 px-3 py-2.5'
       } ${
         isGroupActive
           ? collapsed
diff --git a/frontend/src/components/Topbar.jsx b/frontend/src/components/Topbar.jsx
index 6b37c9e..7dc6ea8 100644
--- a/frontend/src/components/Topbar.jsx
+++ b/frontend/src/components/Topbar.jsx
@@ -26,12 +26,26 @@ import { useSidebar } from '../contexts/SidebarContext';
 //   swap total). Sekarang KEDUA ikon di-render bareng ditumpuk (`absolute`
 //   di atas 1 sama lain), yang keliatan cuma diatur lewat `opacity`
 //   di-transition - jadi crossfade mulus, bukan loncat.
+//
+// Revisi lagi (feedback ke-2, dari screenshot): "posisi icon tutup sidebar
+// masih sama jauh [pas collapsed]". `.topbar` (class CSS lama, belum
+// direskin) punya `padding: 0 32px` TETAP, gak peduli sidebar collapsed
+// atau enggak - jadi tombolnya selalu 32px dari border sidebar, gak pernah
+// "ngedeket" pas sidebar-nya udah nyempit ke 76px. Di-override lewat inline
+// style (padding-left doang, bukan ubah class lama) jadi lebih rapat pas
+// collapsed. CATATAN: sidebar & topbar itu 2 kolom flex terpisah (lihat
+// MainLayout.jsx) yang dibatasin border - gak akan pernah bener-bener
+// segaris pixel-perfect sama kolom icon di dalam sidebar, tapi ini bikin
+// jaraknya jauh lebih rapat & kerasa nyambung.
 function Topbar() {
   const { title, actions } = useCurrentPageHeader();
   const { collapsed, toggleCollapsed } = useSidebar();
 
   return (
-    <header className="topbar">
+    <header
+      className="topbar"
+      style={{ paddingLeft: collapsed ? '16px' : '32px', transition: 'padding-left 250ms ease-in-out' }}
+    >
       <div className="flex items-center gap-3.5">
         <button
           type="button"
-- 
2.43.0

